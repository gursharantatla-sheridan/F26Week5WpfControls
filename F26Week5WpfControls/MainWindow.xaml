<Window x:Class="F26Week5WpfControls.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:F26Week5WpfControls"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" FontSize="16" FontWeight="Bold">
    <Canvas>
        <Button x:Name="btnShowGrid" Content="Show Grid Example" HorizontalAlignment="Left" VerticalAlignment="Top" Height="44" Width="163" Click="btnShowGrid_Click" Canvas.Left="583" Canvas.Top="27"/>

        <Canvas Height="95" Width="161" Canvas.Left="32" Canvas.Top="27" Background="#FFC5F4CC">
            <Button Content="Button 1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            <Button Content="Button 2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        </Canvas>
        <Image Height="93" Canvas.Left="226" Canvas.Top="27" Width="142" Source="/Car.png" HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <GroupBox Height="157" Header="Hobbies" Width="177" Canvas.Left="32" Canvas.Top="150">
            <StackPanel x:Name="spHobbies">
                <CheckBox Content="Gardening" Margin="5"/>
                <CheckBox Content="Singing" Margin="5"/>
                <CheckBox Content="Sports" Margin="5"/>
                <CheckBox Content="Hiking" Margin="5"/>
            </StackPanel>
        </GroupBox>
        <Button x:Name="btnGetHobbies" Content="Get Hobbies" Canvas.Left="226" Canvas.Top="166" Height="34" Width="114"/>
        <Label x:Name="lblOutput" Content="" Canvas.Left="572" Canvas.Top="261" Height="133" Width="184" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#FFD4FBCF"/>

    </Canvas>
</Window>
