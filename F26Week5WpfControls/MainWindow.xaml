<Window x:Class="F26Week5WpfControls.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:F26Week5WpfControls"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" FontSize="16" FontWeight="Bold">
    <Canvas>
        <Button x:Name="btnShowGrid" Content="Show Grid Example" HorizontalAlignment="Left" VerticalAlignment="Top" Height="44" Width="163" Click="btnShowGrid_Click" Canvas.Left="583" Canvas.Top="27"/>

        <Canvas Height="95" Width="161" Canvas.Left="32" Canvas.Top="27" Background="#FFC5F4CC">
            <Button Content="Button 1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            <Button Content="Button 2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        </Canvas>
        <Image Height="93" Canvas.Left="226" Canvas.Top="27" Width="142" Source="/Car.png" HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <GroupBox Height="157" Header="Hobbies" Width="177" Canvas.Left="32" Canvas.Top="127" HorizontalAlignment="Center" VerticalAlignment="Top">
            <StackPanel x:Name="spHobbies">
                <CheckBox Content="Gardening" Margin="5"/>
                <CheckBox Content="Singing" Margin="5"/>
                <CheckBox Content="Sports" Margin="5"/>
                <CheckBox Content="Hiking" Margin="5"/>
            </StackPanel>
        </GroupBox>
        <Button x:Name="btnGetHobbies" Content="Get Hobbies" Canvas.Left="226" Canvas.Top="147" Height="34" Width="114" Click="btnGetHobbies_Click" HorizontalAlignment="Center" VerticalAlignment="Top"/>
        <Label x:Name="lblOutput" Content="" Canvas.Left="572" Canvas.Top="261" Height="133" Width="184" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#FFD4FBCF"/>

        <GroupBox Height="116" Header="Gender" Width="177" Canvas.Left="32" Canvas.Top="294" HorizontalAlignment="Left" VerticalAlignment="Center">
            <StackPanel x:Name="spGender">
                <RadioButton Content="Female" Margin="5"/>
                <RadioButton Content="Male" Margin="5"/>
                <RadioButton Content="Other" Margin="5"/>
            </StackPanel>
        </GroupBox>
        <Button x:Name="btnGetGender" Content="Get Gender" Canvas.Left="226" Canvas.Top="310" Height="34" Width="114" HorizontalAlignment="Center" VerticalAlignment="Top" Click="btnGetGender_Click"/>

        <ComboBox x:Name="cmbCities" Canvas.Left="439" Canvas.Top="144" Width="120" HorizontalAlignment="Left" VerticalAlignment="Top" SelectionChanged="cmbCities_SelectionChanged" SelectedIndex="0">
            <ComboBoxItem Content="Select a city"/>
            <ComboBoxItem Content="Toronto"/>
            <ComboBoxItem Content="London"/>
            <ComboBoxItem Content="Paris"/>
            <ComboBoxItem Content="Tokyo"/>
            <ComboBoxItem Content="Sydney"/>
            <ComboBoxItem Content="Cape Town"/>
            <ListBox d:ItemsSource="{d:SampleData ItemCount=5}"/>
        </ComboBox>
        <Label Content="Cities" Canvas.Left="383" Canvas.Top="142"/>
        <Button x:Name="btnGetCity" Content="Get City" Canvas.Left="564" Canvas.Top="140" Height="34" Width="114" HorizontalAlignment="Left" VerticalAlignment="Top" Click="btnGetCity_Click"/>
        
        <ListBox x:Name="lstCountries" Height="172" Width="152" Canvas.Left="383" Canvas.Top="206" HorizontalAlignment="Left" VerticalAlignment="Center" SelectionMode="Extended">
            <ListBoxItem Content="Canada"/>
            <ListBoxItem Content="England"/>
            <ListBoxItem Content="Australia"/>
            <ListBoxItem Content="South Africa"/>
            <ListBoxItem Content="Japan"/>
        </ListBox>

    </Canvas>
</Window>
